# ---- Python ----
.venv/
.env
__pycache__/
*.py[cod]

# ---- PyInstaller 产物 ----
build/
dist/

# ---- Agent 干活用的临时目录（旧 demo 留下的，现在由 bash 工具自己管）----
sandbox/

# ---- Claude Code ----
# settings.local.json 由 collab.py hooks --write 按机器生成（里面有绝对路径和
# 平台相关的解释器名），提交上去只会让两台机器互相覆盖。协作约定写 CLAUDE.md。
.claude/settings.local.json
.claude/settings.local.json.bak-collab

# ---- 发版产物（CI artifact 下载 + 本地拼的清单，不进仓库）----
artifact/
release/

# ---- 凭证：任何形式的 token / 密钥文件都不许进仓库 ----
# 协作分支两边可见、永久留在 git 历史里，删掉也追不回来。
github_token.txt
*_token.txt
!*_token.txt.example
